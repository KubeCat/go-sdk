response 200 OK headers=[Cache-Control="no-cache, no-transform" Connection="keep-alive" Content-Type="text/event-stream" Date="<date>" X-Accel-Buffering="no"] body follows as events
  got event: message | data: {"jsonrpc":"2.0","method":"notifications/subscriptions/acknowledged","params":{"_meta":{"io.modelcontextprotocol/subscriptionId":40},"notifications":{"resourceSubscriptions":["fixture://note"]}}}
  go SubscribeHandler uri=fixture://note
  go ResourceUpdated err=<nil>
  got event: message | data: {"jsonrpc":"2.0","method":"notifications/resources/updated","params":{"_meta":{"io.modelcontextprotocol/subscriptionId":40},"uri":"fixture://note"}}
  <client closes the stream>
  go UnsubscribeHandler uri=fixture://note
  go ResourceUpdated err=<nil>
