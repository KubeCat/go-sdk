response 200 OK headers=[Cache-Control="no-cache, no-transform" Content-Length="103" Content-Type="application/json" Date="<date>"] body={"jsonrpc":"2.0","id":16,"result":{"handler":"tasks/cancel","sawTaskId":"t-1","sawTasksDeclared":true}}
