response 200 OK headers=[Cache-Control="no-cache, no-transform" Content-Length="122" Content-Type="application/json" Date="<date>"] body={"jsonrpc":"2.0","id":10,"result":{"content":[{"type":"text","text":"echo {\"name\":\"echo\",\"arguments\":{\"a\":1}}"}]}}
request POST headers=[Accept="application/json, text/event-stream" Content-Type="application/json" Mcp-Protocol-Version="2025-11-25" Mcp-Session-Id="session-4"] body={"jsonrpc":"2.0","id":11,"method":"tasks/get","params":{"taskId":"t-1","value":"v"}}
response 200 OK headers=[Cache-Control="no-cache, no-transform" Content-Length="113" Content-Type="application/json" Date="<date>"] body={"jsonrpc":"2.0","id":11,"result":{"handler":"tasks/get","sawTaskId":"t-1","value":"v","sawTasksDeclared":false}}
request POST headers=[Accept="application/json, text/event-stream" Content-Type="application/json" Mcp-Protocol-Version="2025-11-25" Mcp-Session-Id="session-4"] body={"jsonrpc":"2.0","id":12,"method":"tasks/cancel","params":{"_meta":{"io.modelcontextprotocol/clientCapabilities":{"roots":{"listChanged":true},"extensions":{"io.modelcontextprotocol/tasks":{}}}},"taskId":"t-1"}}
response 200 OK headers=[Cache-Control="no-cache, no-transform" Content-Length="103" Content-Type="application/json" Date="<date>"] body={"jsonrpc":"2.0","id":12,"result":{"handler":"tasks/cancel","sawTaskId":"t-1","sawTasksDeclared":true}}
== end of the first session ==
request DELETE headers=[Accept="application/json, text/event-stream" Content-Type="application/json" Mcp-Protocol-Version="2025-11-25" Mcp-Session-Id="session-3"] body=
response 204 No Content headers=[Date="<date>"] body=
  <end of stream>
  <client closes the stream>
request POST headers=[Accept="application/json, text/event-stream" Content-Type="application/json" Mcp-Protocol-Version="2025-11-25" Mcp-Session-Id="session-3"] body={"jsonrpc":"2.0","id":13,"method":"tools/call","params":{"name":"echo","arguments":{}}}
response 404 Not Found headers=[Content-Length="18" Content-Type="text/plain; charset=utf-8" Date="<date>" X-Content-Type-Options="nosniff"] body=session not found

== the second session goes on ==
