== handshake ==
c>s {"jsonrpc":"2.0","id":1,"method":"server/discover","params":{"_meta":{"io.modelcontextprotocol/clientCapabilities":{"roots":{"listChanged":true}},"io.modelcontextprotocol/clientInfo":{"name":"plain-client","version":"v1"},"io.modelcontextprotocol/protocolVersion":"2026-07-28"}}}
s>c {"jsonrpc":"2.0","id":1,"error":{"code":-32601,"message":"method not found: server/discover"}}
c>s {"jsonrpc":"2.0","id":2,"method":"initialize","params":{"clientInfo":{"name":"plain-client","version":"v1"},"protocolVersion":"2025-11-25","capabilities":{"roots":{"listChanged":true}}}}
s>c {"jsonrpc":"2.0","id":2,"result":{"capabilities":{"tools":{"listChanged":true},"resources":{"subscribe":true},"extensions":{"io.modelcontextprotocol/tasks":{}}},"protocolVersion":"2025-11-25","serverInfo":{"name":"raw-server","version":"v1"}}}
c>s {"jsonrpc":"2.0","method":"notifications/initialized","params":{}}
== a task result nobody asked for ==
c>s {"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"task","arguments":{}}}
s>c {"jsonrpc":"2.0","id":3,"result":{"resultType":"task","taskId":"t-1","status":"working","statusMessage":"busy","createdAt":"2026-01-02T03:04:05Z","lastUpdatedAt":"2026-01-02T03:04:06Z","ttlMs":60000,"pollIntervalMs":500}}
go CallTool(task) marshal={"content":[],"resultType":"task"} needsInput=false isError=false content=0
== an error that asks for the tasks capability ==
c>s {"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"needs-tasks","arguments":{}}}
s>c {"jsonrpc":"2.0","id":4,"error":{"code":-32021,"message":"missing required tasks extension capability","data":{"requiredCapabilities":{"extensions":{"io.modelcontextprotocol/tasks":{}}}}}}
go CallTool(needs-tasks) err="calling \"tools/call\": missing required tasks extension capability"
== notifications/tasks nobody subscribed to ==
c>s {"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"notify:working","arguments":{}}}
s>c {"jsonrpc":"2.0","method":"notifications/tasks","params":{"taskId":"t-1","status":"working","statusMessage":"busy","createdAt":"2026-01-02T03:04:05Z","lastUpdatedAt":"2026-01-02T03:04:06Z","ttlMs":60000,"pollIntervalMs":500}}
s>c {"jsonrpc":"2.0","id":5,"result":{"content":[{"type":"text","text":"plain"}],"resultType":"complete"}}
go CallTool(notify:working) marshal={"content":[{"type":"text","text":"plain"}],"resultType":"complete"} needsInput=false isError=false content=1
c>s {"jsonrpc":"2.0","id":6,"method":"tools/call","params":{"name":"notify:with-subscription-id","arguments":{}}}
s>c {"jsonrpc":"2.0","method":"notifications/tasks","params":{"_meta":{"io.modelcontextprotocol/subscriptionId":3},"taskId":"t-1","status":"working","statusMessage":"busy","createdAt":"2026-01-02T03:04:05Z","lastUpdatedAt":"2026-01-02T03:04:06Z","ttlMs":60000,"pollIntervalMs":500}}
s>c {"jsonrpc":"2.0","id":6,"result":{"content":[{"type":"text","text":"plain"}],"resultType":"complete"}}
go CallTool(notify:with-subscription-id) marshal={"content":[{"type":"text","text":"plain"}],"resultType":"complete"} needsInput=false isError=false content=1
c>s {"jsonrpc":"2.0","id":7,"method":"tools/call","params":{"name":"notify:completed","arguments":{}}}
s>c {"jsonrpc":"2.0","method":"notifications/tasks","params":{"taskId":"t-1","status":"completed","createdAt":"2026-01-02T03:04:05Z","lastUpdatedAt":"2026-01-02T03:04:06Z","ttlMs":null,"result":{"content":[{"type":"text","text":"done"}]}}}
s>c {"jsonrpc":"2.0","id":7,"result":{"content":[{"type":"text","text":"plain"}],"resultType":"complete"}}
go CallTool(notify:completed) marshal={"content":[{"type":"text","text":"plain"}],"resultType":"complete"} needsInput=false isError=false content=1
c>s {"jsonrpc":"2.0","id":8,"method":"tools/call","params":{"name":"notify:taskid-number","arguments":{}}}
s>c {"jsonrpc":"2.0","method":"notifications/tasks","params":{"taskId":7,"status":"working"}}
s>c {"jsonrpc":"2.0","id":8,"result":{"content":[{"type":"text","text":"plain"}],"resultType":"complete"}}
go CallTool(notify:taskid-number) marshal={"content":[{"type":"text","text":"plain"}],"resultType":"complete"} needsInput=false isError=false content=1
c>s {"jsonrpc":"2.0","id":9,"method":"tools/call","params":{"name":"notify:no-params","arguments":{}}}
s>c {"jsonrpc":"2.0","method":"notifications/tasks"}
s>c {"jsonrpc":"2.0","id":9,"result":{"content":[{"type":"text","text":"plain"}],"resultType":"complete"}}
go CallTool(notify:no-params) marshal={"content":[{"type":"text","text":"plain"}],"resultType":"complete"} needsInput=false isError=false content=1
c>s {"jsonrpc":"2.0","id":10,"method":"tools/call","params":{"name":"notify:legacy-name","arguments":{}}}
s>c {"jsonrpc":"2.0","method":"notifications/tasks/status","params":{"taskId":"t-1","status":"working"}}
s>c {"jsonrpc":"2.0","id":10,"result":{"content":[{"type":"text","text":"plain"}],"resultType":"complete"}}
go CallTool(notify:legacy-name) marshal={"content":[{"type":"text","text":"plain"}],"resultType":"complete"} needsInput=false isError=false content=1
