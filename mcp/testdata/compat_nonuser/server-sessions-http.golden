response 200 OK headers=[Cache-Control="no-cache, no-transform" Content-Length="122" Content-Type="application/json" Date="<date>"] body={"jsonrpc":"2.0","id":14,"result":{"content":[{"type":"text","text":"echo {\"name\":\"echo\",\"arguments\":{\"a\":1}}"}]}}
