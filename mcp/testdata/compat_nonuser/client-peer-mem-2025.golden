== ordinary calls afterwards ==
c>s {"jsonrpc":"2.0","id":24,"method":"tools/list"}
s>c {"jsonrpc":"2.0","id":24,"result":{"tools":[{"name":"plain","inputSchema":{"type":"object"},"execution":{"taskSupport":"required"}}]}}
go ListTools {"ttlMs":0,"cacheScope":"","tools":[{"inputSchema":{"type":"object"},"name":"plain"}]} err=<nil>
c>s {"jsonrpc":"2.0","id":25,"method":"tools/call","params":{"name":"plain","arguments":{}}}
s>c {"jsonrpc":"2.0","id":25,"result":{"content":[{"type":"text","text":"plain"}],"resultType":"complete"}}
go CallTool(plain) marshal={"content":[{"type":"text","text":"plain"}],"resultType":"complete"} needsInput=false isError=false content=1
== close ==
c>s <closed>
go Close err=<nil>
