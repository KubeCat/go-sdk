== server/discover on a server with sessions ==
request POST headers=[Accept="application/json, text/event-stream" Content-Type="application/json" Mcp-Method="server/discover" Mcp-Protocol-Version="2026-07-28"] body={"jsonrpc":"2.0","id":1,"method":"server/discover","params":{"_meta":{"io.modelcontextprotocol/clientCapabilities":{"roots":{"listChanged":true}},"io.modelcontextprotocol/clientInfo":{"name":"raw-caller","version":"v1"},"io.modelcontextprotocol/protocolVersion":"2026-07-28"}}}
response 200 OK headers=[Cache-Control="no-cache, no-transform" Content-Length="360" Content-Type="application/json" Date="<date>"] body={"jsonrpc":"2.0","id":1,"result":{"resultType":"complete","_meta":{"io.modelcontextprotocol/serverInfo":{"name":"plain-server","version":"v1"}},"ttlMs":0,"cacheScope":"public","supportedVersions":["2025-11-25","2025-06-18","2025-03-26","2024-11-05"],"capabilities":{"logging":{},"resources":{"listChanged":true,"subscribe":true},"tools":{"listChanged":true}}}}
request POST headers=[Accept="application/json, text/event-stream" Content-Type="application/json" Mcp-Method="server/discover" Mcp-Protocol-Version="2026-07-28"] body={"jsonrpc":"2.0","id":2,"method":"server/discover","params":{"_meta":{"io.modelcontextprotocol/clientCapabilities":{"roots":{"listChanged":true},"extensions":{"io.modelcontextprotocol/tasks":{}}},"io.modelcontextprotocol/clientInfo":{"name":"raw-caller","version":"v1"},"io.modelcontextprotocol/protocolVersion":"2026-07-28"}}}
response 200 OK headers=[Cache-Control="no-cache, no-transform" Content-Length="360" Content-Type="application/json" Date="<date>"] body={"jsonrpc":"2.0","id":2,"result":{"resultType":"complete","_meta":{"io.modelcontextprotocol/serverInfo":{"name":"plain-server","version":"v1"}},"ttlMs":0,"cacheScope":"public","supportedVersions":["2025-11-25","2025-06-18","2025-03-26","2024-11-05"],"capabilities":{"logging":{},"resources":{"listChanged":true,"subscribe":true},"tools":{"listChanged":true}}}}
== first session ==
request POST headers=[Accept="application/json, text/event-stream" Content-Type="application/json"] body={"jsonrpc":"2.0","id":3,"method":"initialize","params":{"protocolVersion":"2025-11-25","capabilities":{"extensions":{"io.modelcontextprotocol/tasks":{}},"tasks":{"requests":{"tools":{"call":{}}}}},"clientInfo":{"name":"raw-caller","version":"v1"}}}
response 200 OK headers=[Cache-Control="no-cache, no-transform" Content-Length="227" Content-Type="application/json" Date="<date>" Mcp-Session-Id="session-3"] body={"jsonrpc":"2.0","id":3,"result":{"capabilities":{"logging":{},"resources":{"listChanged":true,"subscribe":true},"tools":{"listChanged":true}},"protocolVersion":"2025-11-25","serverInfo":{"name":"plain-server","version":"v1"}}}
request POST headers=[Accept="application/json, text/event-stream" Content-Type="application/json" Mcp-Protocol-Version="2025-11-25" Mcp-Session-Id="session-3"] body={"jsonrpc":"2.0","method":"notifications/initialized"}
response 202 Accepted headers=[Content-Length="0" Date="<date>"] body=
request GET headers=[Accept="text/event-stream" Mcp-Protocol-Version="2025-11-25" Mcp-Session-Id="session-3"] body=
response 200 OK headers=[Cache-Control="no-cache, no-transform" Connection="keep-alive" Content-Type="text/event-stream" Date="<date>"] body follows as events
  got : ok
request POST headers=[Accept="application/json, text/event-stream" Content-Type="application/json" Mcp-Protocol-Version="2025-11-25" Mcp-Session-Id="session-3"] body={"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"echo","arguments":{"a":1},"task":{"ttl":1000}}}
response 200 OK headers=[Cache-Control="no-cache, no-transform" Content-Length="121" Content-Type="application/json" Date="<date>"] body={"jsonrpc":"2.0","id":4,"result":{"content":[{"type":"text","text":"echo {\"name\":\"echo\",\"arguments\":{\"a\":1}}"}]}}
request POST headers=[Accept="application/json, text/event-stream" Content-Type="application/json" Mcp-Protocol-Version="2025-11-25" Mcp-Session-Id="session-3"] body={"jsonrpc":"2.0","id":5,"method":"tasks/get","params":{"taskId":"t-1","value":"v"}}
response 200 OK headers=[Cache-Control="no-cache, no-transform" Content-Length="112" Content-Type="application/json" Date="<date>"] body={"jsonrpc":"2.0","id":5,"result":{"handler":"tasks/get","sawTaskId":"t-1","value":"v","sawTasksDeclared":false}}
request POST headers=[Accept="application/json, text/event-stream" Content-Type="application/json" Mcp-Protocol-Version="2025-11-25" Mcp-Session-Id="session-3"] body={"jsonrpc":"2.0","id":6,"method":"tasks/cancel","params":{"_meta":{"io.modelcontextprotocol/clientCapabilities":{"roots":{"listChanged":true},"extensions":{"io.modelcontextprotocol/tasks":{}}}},"taskId":"t-1"}}
response 200 OK headers=[Cache-Control="no-cache, no-transform" Content-Length="102" Content-Type="application/json" Date="<date>"] body={"jsonrpc":"2.0","id":6,"result":{"handler":"tasks/cancel","sawTaskId":"t-1","sawTasksDeclared":true}}
request POST headers=[Accept="application/json, text/event-stream" Content-Type="application/json" Mcp-Protocol-Version="2025-11-25" Mcp-Session-Id="session-3"] body={"jsonrpc":"2.0","id":7,"method":"resources/subscribe","params":{"uri":"fixture://note"}}
response 200 OK headers=[Cache-Control="no-cache, no-transform" Content-Length="36" Content-Type="application/json" Date="<date>"] body={"jsonrpc":"2.0","id":7,"result":{}}
go SubscribeHandler uri=fixture://note
go ResourceUpdated err=<nil>
  got event: message | data: {"jsonrpc":"2.0","method":"notifications/resources/updated","params":{"uri":"fixture://note"}}
request POST headers=[Accept="application/json, text/event-stream" Content-Type="application/json" Mcp-Protocol-Version="2025-11-25" Mcp-Session-Id="session-3"] body={"jsonrpc":"2.0","id":8,"method":"resources/unsubscribe","params":{"uri":"fixture://note"}}
response 200 OK headers=[Cache-Control="no-cache, no-transform" Content-Length="36" Content-Type="application/json" Date="<date>"] body={"jsonrpc":"2.0","id":8,"result":{}}
go UnsubscribeHandler uri=fixture://note
go ResourceUpdated err=<nil>
== second session while the first is open ==
