== subscription acknowledgements naming tasks ==
c>s {"jsonrpc":"2.0","id":16,"method":"resources/subscribe","params":{"uri":"fixture://note-0"}}
s>c {"jsonrpc":"2.0","id":16,"result":{}}
s>c {"jsonrpc":"2.0","method":"notifications/subscriptions/acknowledged","params":{"notifications":{"resourceSubscriptions":["fixture://note-0"],"taskIds":["t-1"]}}}
s>c {"jsonrpc":"2.0","method":"notifications/resources/updated","params":{"uri":"fixture://note-0"}}
go Subscribe(fixture://note-0) err=<nil>
go ResourceUpdatedHandler uri=fixture://note-0
c>s {"jsonrpc":"2.0","id":17,"method":"resources/unsubscribe","params":{"uri":"fixture://note-0"}}
s>c {"jsonrpc":"2.0","id":17,"result":{}}
go Unsubscribe(fixture://note-0) err=<nil>
