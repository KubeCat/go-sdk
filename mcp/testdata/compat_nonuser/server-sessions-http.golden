response 200 OK headers=[Cache-Control="no-cache, no-transform" Content-Length="227" Content-Type="application/json" Date="<date>" Mcp-Session-Id="session-4"] body={"jsonrpc":"2.0","id":9,"result":{"capabilities":{"logging":{},"resources":{"listChanged":true,"subscribe":true},"tools":{"listChanged":true}},"protocolVersion":"2025-11-25","serverInfo":{"name":"plain-server","version":"v1"}}}
