== subscriptions/listen naming tasks and a resource ==
request POST headers=[Accept="application/json, text/event-stream" Content-Type="application/json" Mcp-Method="subscriptions/listen" Mcp-Protocol-Version="2026-07-28"] body={"jsonrpc":"2.0","id":39,"method":"subscriptions/listen","params":{"_meta":{"io.modelcontextprotocol/clientCapabilities":{"roots":{"listChanged":true}},"io.modelcontextprotocol/clientInfo":{"name":"raw-caller","version":"v1"},"io.modelcontextprotocol/protocolVersion":"2026-07-28"},"notifications":{"resourceSubscriptions":["fixture://note"],"taskIds":["t-1"]}}}
response 200 OK headers=[Cache-Control="no-cache, no-transform" Connection="keep-alive" Content-Type="text/event-stream" Date="<date>" X-Accel-Buffering="no"] body follows as events
  got event: message | data: {"jsonrpc":"2.0","method":"notifications/subscriptions/acknowledged","params":{"_meta":{"io.modelcontextprotocol/subscriptionId":39},"notifications":{"resourceSubscriptions":["fixture://note"]}}}
  go SubscribeHandler uri=fixture://note
  go ResourceUpdated err=<nil>
  got event: message | data: {"jsonrpc":"2.0","method":"notifications/resources/updated","params":{"_meta":{"io.modelcontextprotocol/subscriptionId":39},"uri":"fixture://note"}}
  <client closes the stream>
  go UnsubscribeHandler uri=fixture://note
  go ResourceUpdated err=<nil>
